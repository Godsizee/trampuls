# Rohdaten und Cache — gehören aufs Volume, nie ins Repo
/static/
/raw/
# Zweite Quelle (ADR-023) -- eigene Baeume, gleiche Regel: Volume, nicht Repo
/static-openrnv/
/raw-openrnv/
/data/
/health/
# Messlaeufe (tools/openrnv-24h) -- Rohabrufe fremder Feeds, gehoeren
# nicht ins Repo (Regel 15)
/messung/
*.parquet
*.duckdb

# Python/dbt — lokale Entwicklungsumgebung und Zwischenprodukte
.venv/
__pycache__/
/transform/target/
/transform/dbt_packages/
/transform/logs/
/transform/.user.yml
/warehouse/

# Frontend — dist und die lokale Datenkopie sind abgeleitet
/web/node_modules/
/web/dist/
/web/public/daten/
# web/public/schrift/ ist bewusst NICHT ignoriert: die Schriftdateien sind
# Teil der Auslieferung (selbst gehostet statt CDN) und muessen ins Repo.
/export/

# Go
/bin/
*.exe
*.test

# Secrets (Regel 15 — nie im Repo)
.env
.env.*
*.pem
*.key

# Werkzeug-Cache (rtk) -- lokal, gehoert niemandem sonst
.rtk/

# Editor/OS
.DS_Store
Thumbs.db
